# pnpm configuration for EAS builds
allowed-build-dependencies=supabase,unrs-resolver

# Override Expo dependencies to SDK 51 compatible versions
expo-linking=~6.3.1
expo-constants=~16.0.2
@expo/metro-runtime=~3.2.3
@expo/dom-webview=~1.2.0
@expo/log-box=~2.2.0
expo=^51.0.0
expo-router=~3.5.24

# Enable pnpm workspace features
auto-install-peers=true
shamefully-hoist=false